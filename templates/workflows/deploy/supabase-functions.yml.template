name: Deploy (Supabase Edge Functions)

# Stack: Supabase edge functions (Deno).
# Triggers only POST-merge on main, and only if supabase/functions/** changed.
# Deploys only the functions that changed (does not redeploy everything).
#
# Required secrets (gh secret set ... -R {{REPO}}):
#   SUPABASE_ACCESS_TOKEN  - access token (supabase login)
# Variable:
#   SUPABASE_PROJECT_REF   - project ref (set below)

on:
  push:
    branches: [main]
    paths:
      - 'supabase/functions/**'
  workflow_dispatch:
    inputs:
      function:
        description: 'Function name (empty = all changed)'
        required: false
        default: ''

permissions:
  contents: read

env:
  SUPABASE_PROJECT_REF: '{{SUPABASE_PROJECT_REF}}'

jobs:
  deploy:
    name: Deploy to Supabase
    runs-on: ubuntu-latest
    if: github.repository == '{{REPO}}'
    steps:
      - name: Placeholder filled in
        # This value is filled in by hand after install. Without this check the
        # workflow runs all the way to `supabase functions deploy` and fails
        # there against a nonexistent project, far from the actual cause.
        run: |
          case "$SUPABASE_PROJECT_REF" in
            *"{{"*) echo "SUPABASE_PROJECT_REF is still the literal placeholder. Set it at the top of this file (your Supabase project ref, from the dashboard URL)." >&2; exit 1 ;;
            "")     echo "SUPABASE_PROJECT_REF is empty. Set it at the top of this file (your Supabase project ref, from the dashboard URL)." >&2; exit 1 ;;
          esac

      - uses: actions/checkout@v5
        with: { fetch-depth: 2 }

      - uses: supabase/setup-cli@v1
        with: { version: latest }

      - name: Login
        run: supabase login --token "$SUPABASE_ACCESS_TOKEN"
        env:
          SUPABASE_ACCESS_TOKEN: ${{ secrets.SUPABASE_ACCESS_TOKEN }}

      - name: Detect changed functions
        id: changed
        # SECURITY: the dispatch input is free text. It travels through env so
        # Actions never substitutes it into the script text, and it is validated
        # before it reaches a command line.
        env:
          FUNCTION_INPUT: ${{ github.event.inputs.function }}
        run: |
          set -eu
          if [ -n "${FUNCTION_INPUT:-}" ]; then
            case "$FUNCTION_INPUT" in
              *[!a-zA-Z0-9_-]*)
                echo "invalid function name: only letters, digits, _ and - are allowed" >&2
                exit 1 ;;
            esac
            echo "fns=$FUNCTION_INPUT" >> "$GITHUB_OUTPUT"
            exit 0
          fi
          CHANGED=$(git diff --name-only ${{ github.event.before }} ${{ github.sha }} \
            | grep "^supabase/functions/" \
            | awk -F/ '{print $3}' \
            | sort -u \
            | grep -v "^_shared$" \
            | tr '\n' ' ')
          echo "fns=$CHANGED" >> $GITHUB_OUTPUT
          echo "Changed: $CHANGED"

      - name: Deploy
        if: steps.changed.outputs.fns != ''
        run: |
          set -e
          for fn in ${{ steps.changed.outputs.fns }}; do
            echo "::group::Deploy $fn"
            supabase functions deploy "$fn" --project-ref "$SUPABASE_PROJECT_REF"
            echo "::endgroup::"
          done
