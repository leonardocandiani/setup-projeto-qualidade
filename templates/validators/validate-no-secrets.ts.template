#!/usr/bin/env bun
/**
 * validate-no-secrets.ts
 *
 * Blocks commits and merges that carry a hardcoded credential. The shapes it
 * looks for live in `secret-patterns.ere` next to this file, which is the same
 * source the CI greps read, so there is one list and not five.
 *
 * Runs in CI and pre-commit. Exit 1 if it finds a violation.
 */

import { readFileSync } from "node:fs";
import { readdir, readFile } from "node:fs/promises";
import { join, relative } from "node:path";

const ROOT = decodeURIComponent(new URL("../..", import.meta.url).pathname);

/**
 * Patterns come from `secret-patterns.ere`, the sibling file that every other
 * secret check in this repo also reads (the CI greps use `grep -E -f` on it).
 * Add a shape there and it arms all of them; there is no second list to keep in
 * sync. Anything unreadable is a hard failure, never a silent empty list: a
 * scanner with no patterns passes everything.
 */
const PATTERN_FILE = join(
  decodeURIComponent(new URL(".", import.meta.url).pathname),
  "secret-patterns.ere",
);

function loadPatterns(): { name: string; regex: RegExp }[] {
  let raw: string;
  try {
    raw = readFileSync(PATTERN_FILE, "utf-8");
  } catch {
    console.error(`\u274c validate-no-secrets: cannot read ${PATTERN_FILE}.`);
    console.error("   Without it this check would pass everything, so it fails instead.");
    process.exit(1);
  }
  const patterns = raw
    .split("\n")
    .map((l) => l.trim())
    .filter((l) => l !== "" && !l.startsWith("#"))
    .map((l) => ({ name: l, regex: new RegExp(l, "g") }));
  if (patterns.length === 0) {
    console.error("\u274c validate-no-secrets: the pattern file has no patterns.");
    process.exit(1);
  }
  return patterns;
}

const SECRET_PATTERNS = loadPatterns();

const IGNORE_DIRS = new Set([
  ".git", "node_modules", ".next", ".vercel", "dist", "build",
  "__pycache__", ".venv", ".cache", "coverage", "_assets", ".b64",
]);

// Ignore files that typically contain base64 (encoded images) — common false positive
const IGNORE_FILES_REGEX = /\.(b64|asset|jpg|png|jpeg|gif|webp|svg)\.?(ts|js)?$/i;

const TEXT_EXTS = new Set([".ts", ".tsx", ".js", ".jsx", ".py", ".sh", ".md", ".yml", ".yaml", ".json", ".env", ".sql", ".env.example"]);

interface Hit {
  file: string;
  line: number;
  pattern: string;
  preview: string;
}

async function walk(dir: string, hits: Hit[] = []): Promise<Hit[]> {
  let entries;
  try { entries = await readdir(dir, { withFileTypes: true }); }
  catch { return hits; }

  for (const e of entries) {
    if (IGNORE_DIRS.has(e.name)) continue;
    if (IGNORE_FILES_REGEX.test(e.name)) continue;
    const full = join(dir, e.name);

    if (e.isDirectory()) {
      await walk(full, hits);
      continue;
    }
    const ext = e.name.substring(e.name.lastIndexOf("."));
    if (e.name === "secret-patterns.ere") continue; // holds patterns, never values
    if (!TEXT_EXTS.has(ext) && !e.name.startsWith(".env")) continue;

    try {
      const content = await readFile(full, "utf-8");
      const lines = content.split("\n");
      for (let i = 0; i < lines.length; i++) {
        for (const p of SECRET_PATTERNS) {
          p.regex.lastIndex = 0;
          const m = p.regex.exec(lines[i]);
          if (m) {
            hits.push({
              file: relative(ROOT, full),
              line: i + 1,
              pattern: p.name,
              preview: m[0].substring(0, 25) + "...",
            });
          }
        }
      }
    } catch { /* ignore binary */ }
  }
  return hits;
}

async function main() {
  const hits = await walk(ROOT);

  // .env.example may have placeholders (does not block)
  const filtered = hits.filter((h) => !h.file.includes(".env.example") && !h.file.includes(".env.local.example"));

  if (filtered.length === 0) {
    console.log("✅ validate-no-secrets: no hardcoded token detected.");
    process.exit(0);
  }

  console.error(`❌ validate-no-secrets: ${filtered.length} possible hardcoded tokens:`);
  for (const h of filtered) {
    console.error(`   ${h.file}:${h.line}  (${h.pattern})`);
    console.error(`      ${h.preview}`);
  }
  console.error("\nMove to .env (gitignored) or Supabase secrets / Vercel env vars.");
  process.exit(1);
}

main();
